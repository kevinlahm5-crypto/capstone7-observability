{
  "widgets": [
    {
      "type": "metric",
      "x": 0, "y": 0, "width": 12, "height": 6,
      "properties": {
        "title": "ALB Request Count & 5xx Errors",
        "metrics": [
          [ "AWS/ApplicationELB", "RequestCount", "LoadBalancer", "app/capstone7-alb/c3fc2b5e4b59abd9", { "stat": "Sum" } ],
          [ "AWS/ApplicationELB", "HTTPCode_Target_5XX_Count", "LoadBalancer", "app/capstone7-alb/c3fc2b5e4b59abd9", { "stat": "Sum" } ]
        ],
        "period": 300,
        "region": "us-east-1"
      }
    },
    {
      "type": "metric",
      "x": 12, "y": 0, "width": 12, "height": 6,
      "properties": {
        "title": "ECS CPU & Memory Utilization",
        "metrics": [
          [ "AWS/ECS", "CPUUtilization", "ClusterName", "capstone7-cluster", "ServiceName", "capstone7-app-service", { "stat": "Average" } ],
          [ "AWS/ECS", "MemoryUtilization", "ClusterName", "capstone7-cluster", "ServiceName", "capstone7-app-service", { "stat": "Average" } ]
        ],
        "period": 300,
        "region": "us-east-1"
      }
    },
    {
      "type": "metric",
      "x": 0, "y": 6, "width": 12, "height": 6,
      "properties": {
        "title": "RDS Connections & Latency",
        "metrics": [
          [ "AWS/RDS", "DatabaseConnections", "DBInstanceIdentifier", "capstone7-db", { "stat": "Average" } ],
          [ "AWS/RDS", "ReadLatency", "DBInstanceIdentifier", "capstone7-db", { "stat": "Average" } ],
          [ "AWS/RDS", "WriteLatency", "DBInstanceIdentifier", "capstone7-db", { "stat": "Average" } ]
        ],
        "period": 300,
        "region": "us-east-1"
      }
    },
    {
      "type": "metric",
      "x": 12, "y": 6, "width": 12, "height": 6,
      "properties": {
        "title": "Alarm Status Overview",
        "metrics": [
          [ "AWS/ECS", "CPUUtilization", "ClusterName", "capstone7-cluster", "ServiceName", "capstone7-app-service", { "stat": "Average", "label": "ECS CPU" } ]
        ],
        "period": 300,
        "region": "us-east-1",
        "annotations": {
          "alarms": [
            "arn:aws:cloudwatch:us-east-1:264787847442:alarm:capstone7-ecs-cpu-high",
            "arn:aws:cloudwatch:us-east-1:264787847442:alarm:capstone7-alb-5xx-high",
            "arn:aws:cloudwatch:us-east-1:264787847442:alarm:capstone7-error-count-high"
          ]
        }
      }
    }
  ]
}
